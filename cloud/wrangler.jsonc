{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flickdock-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "account_id": "59153da0809ff3d18297d943e1ef5b56",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flickdock-cloud",
      "database_id": "2f2c1b7e-9206-40fb-bfc5-e399e7fcc6b9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "flickdock-private"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENTS",
        "class_name": "AccountEvents"
      },
      {
        "name": "WAN",
        "class_name": "WanHub"
      }
    ]
  },
  "exports": {
    "AccountEvents": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "WanHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ACCOUNT_QUOTA_BYTES": "8589934592",
    "GLOBAL_QUOTA_BYTES": "8589934592",
    "CHUNK_BYTES": "4194304",
    "SINGLE_PUT_LIMIT_BYTES": "94371840",
    "R2_CLASS_A_BUDGET": "1000000",
    "R2_CLASS_B_BUDGET": "10000000",
    "EMAIL_PROVIDER": "disabled",
    "CF_ACCOUNT_ID": "59153da0809ff3d18297d943e1ef5b56",
    "TURN_KEY_ID": "b524cf6e4dad7144922af7f4866c928d",
    "TURN_ENABLED": "true",
    "TURN_MONTHLY_BUDGET_BYTES": "900000000000"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
