{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flickdock-site",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "main": "worker.mjs",
  "services": [{"binding":"WAN_SERVICE","service":"flickdock-cloud","entrypoint":"AppGateway"}],
  "assets": {
    "directory": "./public",
    "binding":"ASSETS",
    "run_worker_first":["/v1/*"]
  }
}
